# Uncommented empty lines are mandatory settings that must be configured by the user.
# Commented lines are optional


# Public domain or server IP address
SMP_ADDR=

# Main SMP HTTPS port
SMP_PORT_HTTPS=443

# SMP Transport port
SMP_PORT_TRANSPORT=5223

# AGPLv3 license requires that you make any source code modifications
# available to the end users of the server. Include correct source code URI.
SMP_CFG__INFORMATION__source_code=https://github.com/simplex-chat/simplexmq

# Server usage conditions and amendments.
# SMP_CFG__INFORMATION__usage_conditions=https://github.com/simplex-chat/simplex-chat/blob/stable/PRIVACY.md
# SMP_CFG__INFORMATION__condition_amendments=

# Server location and operator.
# SMP_CFG__INFORMATION__server_country=
# SMP_CFG__INFORMATION__operator=
# SMP_CFG__INFORMATION__operator_country=
# SMP_CFG__INFORMATION__website=

# Administrative contacts.
# SMP_CFG__INFORMATION__admin_simplex=
# SMP_CFG__INFORMATION__admin_email=
# SMP_CFG__INFORMATION__admin_pgp=
# SMP_CFG__INFORMATION__admin_pgp_fingerprint=

# Contacts for complaints and feedback.
# SMP_CFG__INFORMATION__complaints_simplex=
# SMP_CFG__INFORMATION__complaints_email=
# SMP_CFG__INFORMATION__complaints_pgp=
# SMP_CFG__INFORMATION__complaints_pgp_fingerprint=

# Hosting provider.
# SMP_CFG__INFORMATION__hosting=
# SMP_CFG__INFORMATION__hosting_country=

# Hosting type can be `virtual`, `dedicated`, `colocation`, `owned`
# SMP_CFG__INFORMATION__hosting_type=virtual


# Use `enable: on` to use append-only log to preserve and restore queue records.
SMP_CFG__STORE_LOG__enable=on

# Queue storage mode: `memory` or `database` (to store queue records in PostgreSQL database).
# `memory` - in-memory persistence, with optional append-only log (`enable = on`).
# `database`- PostgreSQL databass (requires `store_messages = journal`).
# SMP_CFG__STORE_LOG__store_queues=memory

# Database connection settings for PostgreSQL database (`store_queues = database`).
# SMP_CFG__STORE_LOG__db_connection=postgresql://smp@/smp_server_store
# SMP_CFG__STORE_LOG__db_schema=smp_server
# SMP_CFG__STORE_LOG__db_pool_size=10

# Write database changes to store log file
# SMP_CFG__STORE_LOG__db_store_log=off

# Time to retain deleted queues in the database, days.
# SMP_CFG__STORE_LOG__db_deleted_ttl=21

# Message storage mode: `memory` or `journal`.
# SMP_CFG__STORE_LOG__store_messages=memory

# Save and restore undelivered messages when the server restarts.
SMP_CFG__STORE_LOG__restore_messages=on

# Messages and notifications expiration periods.
# SMP_CFG__STORE_LOG__expire_messages_days=21
# SMP_CFG__STORE_LOG__expire_messages_on_start=on
# SMP_CFG__STORE_LOG__expire_messages_on_send=off
# SMP_CFG__STORE_LOG__expire_ntfs_hours=24

# Log daily server statistics to CSV file
SMP_CFG__STORE_LOG__log_stats=on

# Log interval for real-time Prometheus metrics
# SMP_CFG__STORE_LOG__prometheus_interval=60


# Completely prohibit creating new messaging queues.
SMP_CFG__AUTH__new_queues=on

# Password required to create new messaging queues (used in smp:// URL).
# SMP_CFG__AUTH__create_password=your_secure_password_here

# Control port passwords.
# SMP_CFG__AUTH__control_port_admin_password=
# SMP_CFG__AUTH__control_port_user_password=

# Limit for queues that can be blocked via control port per day.
# SMP_CFG__AUTH__daily_block_queue_quota=20


# Allow WebSocket transport for client connections
SMP_CFG__TRANSPORT__websockets=off
# SMP_CFG__TRANSPORT__log_tls_errors=off
# SMP_CFG__TRANSPORT__control_port=5224


# Proxy settings
# SMP_CFG__PROXY__host_mode=public
# SMP_CFG__PROXY__required_host_mode=off
# SMP_CFG__PROXY__own_server_domains=
# SMP_CFG__PROXY__socks_proxy=localhost:9050
# SMP_CFG__PROXY__socks_mode=onion
# SMP_CFG__PROXY__client_concurrency=32


# Public-namespace resolution via the snrc-resolve.py REST resolver.
# SMP_CFG__NAMES__enable=off
# SMP_CFG__NAMES__resolver_endpoint=https://your.resolver.com:443
# SMP_CFG__NAMES__resolver_auth=basic <username>:<password>
# SMP_CFG__NAMES__resolver_timeout_ms=3000
# SMP_CFG__NAMES__resolver_max_response_bytes=16000
# SMP_CFG__NAMES__resolver_concurrency=1000


# TTL and interval to check inactive clients
# SMP_CFG__INACTIVE_CLIENTS__disconnect=on
# SMP_CFG__INACTIVE_CLIENTS__ttl=21600
# SMP_CFG__INACTIVE_CLIENTS__check_interval=3600
