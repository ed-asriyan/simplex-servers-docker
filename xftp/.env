# Uncommented empty lines are mandatory settings that must be configured by the user.
# Commented lines are optional

# Public domain or server IP address
XFTP_ADDR=

# Main XFTP HTTPS port
XFTP_PORT_HTTPS=443

# AGPLv3 license requires that you make any source code modifications
# available to the end users of the server. Include correct source code URI.
XFTP_CFG__INFORMATION__source_code=https://github.com/simplex-chat/simplexmq
# XFTP_CFG__INFORMATION__server_country=
# XFTP_CFG__INFORMATION__operator=
# XFTP_CFG__INFORMATION__operator_country=
# XFTP_CFG__INFORMATION__website=
# XFTP_CFG__INFORMATION__admin_simplex=
# XFTP_CFG__INFORMATION__admin_email=
# XFTP_CFG__INFORMATION__complaints_simplex=
# XFTP_CFG__INFORMATION__complaints_email=
# XFTP_CFG__INFORMATION__hosting=
# XFTP_CFG__INFORMATION__hosting_country=
# XFTP_CFG__INFORMATION__hosting_type=virtual

# Enable saving memory to append only log and restoring it on start.
XFTP_CFG__STORE_LOG__enable=on

# File storage mode: `memory` or `database` (PostgreSQL).
# XFTP_CFG__STORE_LOG__store_files=memory

# Database connection settings for PostgreSQL database (`store_files = database`).
# XFTP_CFG__STORE_LOG__db_connection=postgresql://xftp@/xftp_server_store
# XFTP_CFG__STORE_LOG__db_schema=xftp_server
# XFTP_CFG__STORE_LOG__db_pool_size=10

# Write database changes to store log file
# XFTP_CFG__STORE_LOG__db_store_log=off

# Expire files after the specified number of hours.
XFTP_CFG__STORE_LOG__expire_files_hours=48

# Log daily server statistics to CSV file
XFTP_CFG__STORE_LOG__log_stats=off

# Log interval for real-time Prometheus metrics
# XFTP_CFG__STORE_LOG__prometheus_interval=60


# Completely prohibit uploading new files.
XFTP_CFG__AUTH__new_files=on

# Password required to upload new files (used in xftp:// URL).
# XFTP_CFG__AUTH__create_password=your_secure_password_here

# Control port passwords.
# XFTP_CFG__AUTH__control_port_admin_password=
# XFTP_CFG__AUTH__control_port_user_password=


# Note: 'host' and 'port' are rigidly set by docker-compose.yml.
# XFTP_CFG__TRANSPORT__log_tls_errors=off
# XFTP_CFG__TRANSPORT__control_port=5226


# Storage limits for uploaded files. 
XFTP_CFG__FILES__storage_quota=22gb


# TTL and interval to check inactive clients
# XFTP_CFG__INACTIVE_CLIENTS__disconnect=off
# XFTP_CFG__INACTIVE_CLIENTS__ttl=21600
# XFTP_CFG__INACTIVE_CLIENTS__check_interval=3600
